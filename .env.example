# Copy this file to `.env` and adjust the values.

# Folder holding the packets saved by poi, scanned recursively for `*.json`
KCSAPI_SOURCE_PATH=/path/to/config/poi/response-saver/kcsapi

# Only packets saved after this date are processed.
# `commit --advance` rewrites this entry after a run that finished without error.
KCSAPI_LIMIT=2019-10-01T00:00:00.000Z
